pragma language_version >= 0.19;
import CompactStandardLibrary;

// ZEEP v3 — a public handle directory plus direct unshielded transfers.
//
// The directory stores one handle per unshielded recipient address. The UI
// resolves a handle to that address, then the wallet sends tNIGHT directly.
// The address is supplied by the caller: this contract cannot authenticate its
// ownership. Do not treat this map as proof that the registrant controls it.

export ledger usernames: Map<Bytes<32>, Bytes<32>>;
export ledger walletHandles: Map<Bytes<32>, Bytes<32>>;
export ledger handleNames: Map<Bytes<32>, Bytes<32>>;
export ledger recipientAddresses: Map<Bytes<32>, Bytes<32>>;

// A recipient address can appear once and a handle can be used once.
export circuit register(
  nameHash: Bytes<32>,
  nameBytes: Bytes<32>,
  unshieldedAddress: Bytes<32>,
): [] {
  assert(nameHash == persistentHash<Bytes<32>>(nameBytes), "handle hash does not match name");
  assert(unshieldedAddress != default<Bytes<32>>, "invalid recipient address");
  assert(!usernames.member(disclose(nameHash)), "handle already registered");
  assert(!walletHandles.member(disclose(unshieldedAddress)), "address already has a handle");
  usernames.insert(disclose(nameHash), disclose(unshieldedAddress));
  walletHandles.insert(disclose(unshieldedAddress), disclose(nameHash));
  handleNames.insert(disclose(nameHash), disclose(nameBytes));
  recipientAddresses.insert(disclose(nameHash), disclose(unshieldedAddress));
}
